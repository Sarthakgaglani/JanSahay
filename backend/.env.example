APP_ENV=development
DEBUG=false
# Required in production. Use a long random value and do not commit it.
SECRET_KEY=

# SQLite is the practical local default. PostgreSQL is supported when configured.
DATABASE_URL=sqlite:///./jansahay.db

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Select gemini, openai, or openai-compatible. Keys stay on the server only.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=20
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Optional future shared rate-limit/cache backend; not required for local SQLite mode.
REDIS_URL=
